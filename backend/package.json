{
  "name": "notes-app-backend",
  "version": "1.0.0",
  "description": "MERN Notes App — Express/Mongoose REST API",
  "main": "server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "mocha tests/**/*.test.js --exit",
    "test:coverage": "c8 --all --exclude=tests/** --exclude=coverage/** --exclude=server.js --reporter=lcov --reporter=text mocha tests/**/*.test.js --exit"
  },
  "keywords": [
    "notes",
    "mern",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "c8": "^10.1.3",
    "chai-http": "^5.1.2",
    "mocha": "^11.8.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3"
  }
}
